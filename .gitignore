data/raw/*.csv
data/processed/*.csv
!data/raw/.gitkeep
!data/processed/.gitkeep

# Models (large binaries)
models/*.pkl
!models/.gitkeep

# Outputs
outputs/*.csv
outputs/*.json
!outputs/.gitkeep

